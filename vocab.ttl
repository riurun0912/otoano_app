@prefix otoano: <https://riurun2023.github.io/Otoano/vocab#> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mo:     <http://purl.org/ontology/mo/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .

#################################################################
# Otoano Vocabulary
# エレキギター演奏実践知識（音作り・奏法・機材）を記述するための語彙。
# 一般的な概念には schema.org / Dublin Core / Music Ontology を再利用し、
# 本研究に固有の概念（セグメント・奏法の使用・機材設定など）のみを定義する。
# アプリの annotations.json は context.jsonld によって本語彙へ写像される。
#################################################################

<https://riurun2023.github.io/Otoano/vocab#>
    a owl:Ontology ;
    dcterms:title "Otoano Vocabulary"@ja ;
    dcterms:description "エレキギター演奏の実践知識（音作り・奏法・機材・時系列アノテーション）を記述する語彙。"@ja ;
    dcterms:creator "森本理希"@ja ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:seeAlso <https://riurun2023.github.io/Rockband_LOD/dataset.ttl> .

#################################################################
# クラス
#################################################################

otoano:PerformanceAnnotation a rdfs:Class ;
    rdfs:label "演奏アノテーション"@ja ;
    rdfs:subClassOf schema:CreativeWork ;
    rdfs:comment "ある楽曲のあるパートに対する、演奏実践知識のアノテーション一式（annotations.json 1ファイルに対応）。"@ja .

otoano:Segment a rdfs:Class ;
    rdfs:label "セグメント"@ja ;
    rdfs:subClassOf schema:Clip ;
    rdfs:comment "動画の再生時間軸上の区間。開始・終了秒をもち、奏法・機材設定・関連資料が結びつく。"@ja .

otoano:GearUsage a rdfs:Class ;
    rdfs:label "機材の使用"@ja ;
    rdfs:comment "ある文脈（楽曲・セグメント）における特定の機材とその設定値の使用。エレキギターの音作りを構造的に記録する中心クラス。"@ja .

otoano:GearSetting a rdfs:Class ;
    rdfs:label "機材設定値"@ja ;
    rdfs:subClassOf schema:PropertyValue ;
    rdfs:comment "機材の1つのつまみ・パラメータの設定（例: GAIN=3）。schema:propertyID（統制概念 otoano:param/*）/ schema:name（表示名）/ schema:value（値）/ schema:unitText（目盛り）をもつ、定量データとしての記述。"@ja .

otoano:GearParameter a rdfs:Class ;
    rdfs:label "機材パラメータ概念"@ja ;
    rdfs:subClassOf schema:DefinedTerm , skos:Concept ;
    rdfs:comment "GAIN・VOLUME等、機材のつまみの共通概念を統制語彙として定義する。該当しないものは other にまとめる。"@ja .

otoano:GearCategory a rdfs:Class ;
    rdfs:label "機材カテゴリ"@ja ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment "ギター / アンプ / エフェクター / マルチエフェクター等、機材の種類を表す統制語彙の項目。skos:broader により階層をなし、上位カテゴリ（例: エフェクター）と下位の種類（例: 歪み系 → オーバードライブ）を同一クラスで扱う。投稿者は分かる範囲の粒度で選べばよく、上位カテゴリのままでも有効である。"@ja .

otoano:Technique a rdfs:Class ;
    rdfs:label "奏法"@ja ;
    rdfs:subClassOf schema:DefinedTerm , skos:Concept ;
    rdfs:comment "ギター奏法の統制語彙の項目。skos:broader により奏法グループ（基本・コード / ピッキング / フィンガリング / エレキ特有）に束ねる。"@ja .

otoano:ChordProgression a rdfs:Class ;
    rdfs:label "コード進行"@ja ;
    rdfs:subClassOf schema:CreativeWork .

otoano:Score a rdfs:Class ;
    rdfs:label "楽譜"@ja ;
    rdfs:subClassOf schema:CreativeWork .

#################################################################
# 来歴・権利表示は Dublin Core（dcterms:）を再利用する。独自語彙は定義しない。
#   dcterms:creator   投稿者（共創アーカイブにおける帰属表示）
#   dcterms:created   投稿日
#   dcterms:modified  最終更新日
#   dcterms:license   二次利用条件（CC等のURI）
# デジタルアーカイブに求められるメタデータのオープン化と二次利用条件の明示に対応する。
#
# 他者の投稿を引き継いで作られたアノテーションは、原典を schema:isBasedOn で指す
# （JSONキー isBasedOn）。独自プロパティは定義せず schema.org を再利用する。
# これにより、CCライセンスが求める帰属表示を、データ構造として辿れる形で保持する。
#################################################################

#################################################################
# プロパティ
#################################################################

otoano:hasSegment a rdf:Property ;
    rdfs:label "セグメントをもつ"@ja ;
    rdfs:range otoano:Segment .

otoano:start a rdf:Property ;
    rdfs:label "開始秒"@ja ; rdfs:domain otoano:Segment ; rdfs:range xsd:decimal .

otoano:end a rdf:Property ;
    rdfs:label "終了秒"@ja ; rdfs:domain otoano:Segment ; rdfs:range xsd:decimal .

otoano:usesTechnique a rdf:Property ;
    rdfs:label "奏法を用いる"@ja ;
    rdfs:comment "セグメントで用いられる奏法（統制語彙 otoano:* の Technique 個体を参照）。"@ja ;
    rdfs:domain otoano:Segment ; rdfs:range otoano:Technique .

otoano:usesGear a rdf:Property ;
    rdfs:label "機材を用いる"@ja ;
    rdfs:comment "楽曲・セグメントで用いられた機材（製品）への直接リンク。つまみの設定値など詳細は otoano:GearUsage 側に記述し、本プロパティは製品レベルの参照を与えることで「この機材を使っている楽曲」という逆引き検索を可能にする。"@ja ;
    rdfs:range schema:Product .

otoano:paramConcept a rdf:Property ;
    rdfs:label "パラメータ概念"@ja ;
    rdfs:comment "つまみ設定（GearSetting）が、どの共通概念（GAIN等）に該当するかを示す。schema:propertyID の下位。"@ja ;
    rdfs:subPropertyOf schema:propertyID ;
    rdfs:domain otoano:GearSetting ; rdfs:range otoano:GearParameter .

otoano:gearCategory a rdf:Property ;
    rdfs:label "機材カテゴリ"@ja ;
    rdfs:comment "上位8分類（guitar / amp / effector / multi-effector / cable / pick / strings / other）またはその下位分類（例: fx-overdrive, gt-strat）を値にとる。下位分類は skos:broader で上位に接続されるため、上位カテゴリでの検索は SKOS の推移的な包含関係でたどれる。"@ja ;
    rdfs:domain otoano:GearUsage ; rdfs:range otoano:GearCategory .

otoano:hasSetting a rdf:Property ;
    rdfs:label "設定値をもつ"@ja ;
    rdfs:subPropertyOf schema:additionalProperty ;
    rdfs:domain otoano:GearUsage ; rdfs:range otoano:GearSetting .

otoano:category a rdf:Property ;
    rdfs:label "観点カテゴリ"@ja ;
    rdfs:comment "technique（奏法）/ equipment（機材設定）/ other。UIの絞り込みに用いる。"@ja .

otoano:aboutTechnique a rdf:Property ;
    rdfs:label "対応する奏法"@ja ;
    rdfs:comment "関連カード（リンク・動画・画像等）が、そのセグメントのどの奏法に対応する解説かを示す。"@ja ;
    rdfs:subPropertyOf schema:about ;
    rdfs:range otoano:Technique .

otoano:part a rdf:Property ;
    rdfs:label "パート"@ja ;
    rdfs:comment "guitar / bass / drums / vocal などの担当パート。"@ja .

otoano:difficulty a rdf:Property ;
    rdfs:label "難易度"@ja ;
    rdfs:comment "そのパートをコピーする難しさ（otoano:DifficultyScheme の概念）。学習リソースの到達段階を表す schema:educationalLevel を特化させたもので、独自の尺度クラスは定義しない。"@ja ;
    rdfs:subPropertyOf schema:educationalLevel ;
    rdfs:domain otoano:PerformanceAnnotation ; rdfs:range skos:Concept .

# ジャンルは schema:genre をそのまま再利用する（値は otoano:GenreScheme の概念）。

otoano:youtubeVideoId a rdf:Property ;
    rdfs:label "YouTube動画ID"@ja ;
    rdfs:subPropertyOf schema:identifier .

otoano:startTime a rdf:Property ;
    rdfs:label "再生開始位置（秒）"@ja ; rdfs:range xsd:decimal .

otoano:syncStart a rdf:Property ;
    rdfs:label "同期再生の開始秒"@ja ; rdfs:range xsd:decimal .

otoano:chordProgression a rdf:Property ;
    rdfs:label "コード進行データ"@ja ;
    rdfs:comment "拍位置つきコード列（JSONリテラル）。"@ja .

otoano:hasStem a rdf:Property ;
    rdfs:label "パート別音源をもつ"@ja ;
    rdfs:comment "ギター・ベース等、パートごとに分けた音源・映像。実装では YouTube 動画カードで与えるため range は schema:MediaObject とする。"@ja ;
    rdfs:range schema:MediaObject .

otoano:hasGearInfo a rdf:Property ;
    rdfs:label "機材情報をもつ"@ja ;
    rdfs:comment "楽曲全体で用いた機材（otoano:GearUsage）の一覧。セグメント内の機材設定とは別に、曲単位でまとめて参照する。"@ja ;
    rdfs:range otoano:GearUsage .

otoano:hasGlossary a rdf:Property ;
    rdfs:label "用語解説をもつ"@ja .

# 楽譜・歌詞・公式サイト・外部データベースへの参照は schema:citation を再利用する
# （JSONキー references）。独自プロパティは定義しない。

otoano:groClass a rdf:Property ;
    rdfs:label "Guitar Rendition Ontology 対応クラス名"@ja ;
    rdfs:comment "飯野らのギター奏法オントロジー（GRO）における対応クラスのローカル名。"@ja ;
    rdfs:seeAlso <https://github.com/guitar-san/Guitar-Rendition-Ontology> .

otoano:termCategory a rdf:Property ;
    rdfs:label "用語カテゴリ"@ja ;
    rdfs:comment "用語解説の項目が、音楽理論 / 機材 / 奏法 のいずれに関するものかを示す。"@ja ;
    rdfs:domain schema:DefinedTerm ;
    rdfs:range otoano:TermCategory .

#################################################################
# 用語解説の項目は schema:DefinedTerm を再利用する（独自クラスは作らない）。
# name（用語名）/ description（本文）/ url（参考リンク）/ image（画像）/
# termCategory（下記の3分類）で記述する。
#################################################################

otoano:TermCategory a rdfs:Class ;
    rdfs:label "用語カテゴリ"@ja ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment "用語解説の項目が扱う領域（音楽理論 / 機材 / 奏法）を表す統制語彙の項目。"@ja .

otoano:theory     a otoano:TermCategory ; schema:name "音楽理論"@ja .
otoano:equipment  a otoano:TermCategory ; schema:name "機材"@ja .
otoano:technique  a otoano:TermCategory ; schema:name "奏法"@ja ;
    rdfs:seeAlso <https://github.com/guitar-san/Guitar-Rendition-Ontology> .

#################################################################
# 機材カテゴリ（otoano:gearCategory の値）と
# つまみの共通概念（otoano:paramConcept の値＝otoano:GearParameter 個体）
# schema:description は辞書ページ（terms.html）がそのまま描画する解説文。
#################################################################

otoano:guitar a otoano:GearCategory ;
    schema:name "ギター"@ja ;
    schema:description "弦の振動をピックアップで電気信号に変換する楽器。ボディの形状とピックアップの種類によって音の傾向が大きく変わるため、同じ設定でも機種が違えば別の音になる。"@ja ;
    rdfs:seeAlso <https://guitar-hakase.com/4004/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%A8%E3%83%AC%E3%82%AF%E3%83%88%E3%83%AA%E3%83%83%E3%82%AF%E3%83%BB%E3%82%AE%E3%82%BF%E3%83%BC> .

otoano:amp a otoano:GearCategory ;
    schema:name "アンプ"@ja ;
    schema:description "ギターの微弱な信号を増幅してスピーカーから鳴らす装置。真空管アンプは温かみのある音、トランジスタアンプはクリアでタイトな音になる。歪みの多くはここで作られる。"@ja ;
    rdfs:seeAlso <https://ja.wikipedia.org/wiki/%E3%82%A2%E3%83%B3%E3%83%97_(%E6%A5%BD%E5%99%A8%E7%94%A8)> .

otoano:effector a otoano:GearCategory ;
    schema:name "エフェクター"@ja ;
    schema:description "ギターとアンプの間につないで音を加工する機器。歪み・揺らぎ・残響など役割ごとに種類が分かれ、つなぐ順番によっても音が変わる。"@ja ;
    rdfs:seeAlso <https://guitar-hakase.com/effector/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%A8%E3%83%95%E3%82%A7%E3%82%AF%E3%82%BF%E3%83%BC> .

otoano:multi-effector a otoano:GearCategory ;
    schema:name "マルチエフェクター"@ja ;
    schema:description "多数のエフェクターとアンプの音を1台にまとめた機器。設定を丸ごと保存・呼び出しできるため、曲ごとの音を素早く切り替えられる。"@ja ;
    rdfs:seeAlso <https://ja.wikipedia.org/wiki/%E3%82%A8%E3%83%95%E3%82%A7%E3%82%AF%E3%82%BF%E3%83%BC> .

otoano:cable a otoano:GearCategory ;
    schema:name "シールド"@ja ;
    schema:description "ギターとアンプ、またはエフェクター同士をつなぐケーブル。ノイズを防ぐために内部がシールド構造になっていることからこう呼ばれる。長さや品質が音に影響することもある。"@ja ;
    rdfs:seeAlso <https://ja.wikipedia.org/wiki/%E3%82%B7%E3%83%BC%E3%83%AB%E3%83%89%E3%82%B1%E3%83%BC%E3%83%96%E3%83%AB> .

otoano:pick a otoano:GearCategory ;
    schema:name "ピック"@ja ;
    schema:description "弦を弾くための小片。厚さと素材でアタック感や音の硬さが変わり、薄いものはストローク向き、厚いものは単音弾き向きとされる。"@ja ;
    rdfs:seeAlso <https://ja.wikipedia.org/wiki/%E3%83%94%E3%83%83%E3%82%AF> .

otoano:strings a otoano:GearCategory ;
    schema:name "弦"@ja ;
    schema:description "太さ（ゲージ）によって音と弾き心地が変わる。細い弦は押さえやすくチョーキングが楽、太い弦は音が太く張りが出る。消耗品であり定期的な交換が必要。"@ja ;
    rdfs:seeAlso <https://ja.wikipedia.org/wiki/%E5%BC%A6_(%E6%A5%BD%E5%99%A8)> .

otoano:other a otoano:GearCategory ;
    schema:name "その他"@ja .

otoano:gain a otoano:GearParameter ; schema:name "GAIN"@ja ; rdfs:comment "歪みの強さ"@ja .
otoano:drive a otoano:GearParameter ; schema:name "DRIVE"@ja .
otoano:level a otoano:GearParameter ; schema:name "LEVEL"@ja .
otoano:volume a otoano:GearParameter ; schema:name "VOLUME"@ja .
otoano:tone a otoano:GearParameter ; schema:name "TONE"@ja .
otoano:treble a otoano:GearParameter ; schema:name "TREBLE"@ja .
otoano:middle a otoano:GearParameter ; schema:name "MIDDLE"@ja .
otoano:bass a otoano:GearParameter ; schema:name "BASS"@ja .
otoano:presence a otoano:GearParameter ; schema:name "PRESENCE"@ja .
otoano:master a otoano:GearParameter ; schema:name "MASTER"@ja .
otoano:reverb a otoano:GearParameter ; schema:name "REVERB"@ja .
otoano:depth a otoano:GearParameter ; schema:name "DEPTH"@ja .
otoano:rate a otoano:GearParameter ; schema:name "RATE"@ja .
otoano:mix a otoano:GearParameter ; schema:name "MIX"@ja .
otoano:time a otoano:GearParameter ; schema:name "TIME"@ja .
otoano:feedback a otoano:GearParameter ; schema:name "FEEDBACK"@ja .
otoano:threshold a otoano:GearParameter ; schema:name "THRESHOLD"@ja .
otoano:sustain a otoano:GearParameter ; schema:name "SUSTAIN"@ja .
otoano:attack a otoano:GearParameter ; schema:name "ATTACK"@ja .
# ギター本体の操作。pickup はつまみではなくセレクター位置だが、設定値（schema:value）を
# もつ GearSetting として同じ枠組みで記述する（値はフロント／センター＋リア等の位置）。
otoano:pickup a otoano:GearParameter ; schema:name "ピックアップ"@ja ;
    rdfs:comment "ギター本体のピックアップ選択（セレクター位置）。値に選択位置を記す。"@ja .
otoano:other-param a otoano:GearParameter ; schema:name "その他"@ja .
# 共通概念に該当しないつまみは otoano:other-param にまとめ、schema:name に実名を記す

#################################################################
# 機材カテゴリの下位分類（skos:broader による階層）
# エフェクターは「系統 → 個別の種類」の2段、ギターはボディ／モデルタイプの1段。
# 値は otoano:gearCategory にそのまま入る（上位カテゴリを入れてもよい＝後方互換）。
# 分類の出典: https://guitar-hakase.com/effector/ , https://guitar-hakase.com/4004/
#################################################################

otoano:fx-drive a otoano:GearCategory ;
    schema:name "歪み系"@ja ;
    schema:description "音を意図的に歪ませ、太さ・伸び・迫力を加える系統。エレキギターの音作りの中心であり、ロックらしい音のほとんどはここで決まる。"@ja ;
    skos:broader otoano:effector ;
    rdfs:seeAlso <https://guitar-hakase.com/effector/> .

otoano:fx-overdrive a otoano:GearCategory ;
    schema:name "オーバードライブ"@ja ;
    schema:description "アンプを過大入力させた時のような自然な歪みを得るエフェクター。ピッキングの強弱に反応しやすく、幅広いジャンルで使われる。Tube Screamer（TS-9）やBOSS BD-2などが定番モデル。"@ja ;
    skos:broader otoano:fx-drive ;
    rdfs:seeAlso <https://guitar-hakase.com/40669/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%AA%E3%83%BC%E3%83%90%E3%83%BC%E3%83%89%E3%83%A9%E3%82%A4%E3%83%96_(%E9%9F%B3%E9%9F%BF%E6%A9%9F%E5%99%A8)> .

otoano:fx-distortion a otoano:GearCategory ;
    schema:name "ディストーション"@ja ;
    schema:description "オーバードライブより深く強い歪みを作るエフェクター。音の粒がそろい伸びが長くなるため、ハードロックやメタルのリフ・ソロに向く。"@ja ;
    skos:broader otoano:fx-drive ;
    rdfs:seeAlso <https://guitar-hakase.com/40574/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%87%E3%82%A3%E3%82%B9%E3%83%88%E3%83%BC%E3%82%B7%E3%83%A7%E3%83%B3_(%E9%9F%B3%E9%9F%BF%E6%A9%9F%E5%99%A8)> .

otoano:fx-fuzz a otoano:GearCategory ;
    schema:name "ファズ"@ja ;
    schema:description "波形を潰しきったような、荒く毛羽立った歪みを作るエフェクター。歪み系の中で最も古く、1960年代のロックを象徴する音として知られる。"@ja ;
    skos:broader otoano:fx-drive ;
    rdfs:seeAlso <https://guitar-hakase.com/40665/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%95%E3%82%A1%E3%82%BA_(%E9%9F%B3%E9%9F%BF%E6%A9%9F%E5%99%A8)> .

otoano:fx-booster a otoano:GearCategory ;
    schema:name "ブースター"@ja ;
    schema:description "歪ませるのではなく信号そのものを持ち上げるエフェクター。ソロだけ音量を上げたり、後段のアンプをより深く歪ませる「押し込み」に使う。"@ja ;
    skos:broader otoano:fx-drive ;
    rdfs:seeAlso <https://guitar-hakase.com/35417/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%96%E3%83%BC%E3%82%B9%E3%82%BF%E3%83%BC_(%E9%9F%B3%E9%9F%BF%E6%A9%9F%E5%99%A8)> .

otoano:fx-modulation a otoano:GearCategory ;
    schema:name "モジュレーション系"@ja ;
    schema:description "音を時間的に揺らして、うねりや広がりを加える系統。コード弾きに立体感を、単音に色気を与える。"@ja ;
    skos:broader otoano:effector ;
    rdfs:seeAlso <https://guitar-hakase.com/effector/> .

otoano:fx-chorus a otoano:GearCategory ;
    schema:name "コーラス"@ja ;
    schema:description "元の音にわずかにずらした音を重ね、複数人で弾いているような厚みと揺らぎを出すエフェクター。クリーントーンのアルペジオと相性がよい。"@ja ;
    skos:broader otoano:fx-modulation ;
    rdfs:seeAlso <https://guitar-hakase.com/35220/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%B3%E3%83%BC%E3%83%A9%E3%82%B9_(%E9%9F%B3%E9%9F%BF%E6%A9%9F%E5%99%A8)> .

otoano:fx-flanger a otoano:GearCategory ;
    schema:name "フランジャー"@ja ;
    schema:description "遅らせた音を重ねた際の干渉によって、ジェット機が通り過ぎるような強いうねりを作るエフェクター。コーラスより効果が派手。"@ja ;
    skos:broader otoano:fx-modulation ;
    rdfs:seeAlso <https://guitar-hakase.com/7359/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%95%E3%83%A9%E3%83%B3%E3%82%B8%E3%83%A3%E3%83%BC> .

otoano:fx-phaser a otoano:GearCategory ;
    schema:name "フェイザー"@ja ;
    schema:description "位相をずらした音を重ね、シュワシュワとした周期的な揺れを作るエフェクター。フランジャーより柔らかく、カッティングと好相性。"@ja ;
    skos:broader otoano:fx-modulation ;
    rdfs:seeAlso <https://guitar-hakase.com/7545/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%95%E3%82%A7%E3%82%A4%E3%82%B6%E3%83%BC_(%E9%9F%B3%E9%9F%BF%E6%A9%9F%E5%99%A8)> .

otoano:fx-tremolo a otoano:GearCategory ;
    schema:name "トレモロ"@ja ;
    schema:description "音量を周期的に上下させ、音が途切れるような揺れを作るエフェクター。速さと深さの設定で、ゆったりした波から細かい刻みまで変化する。"@ja ;
    skos:broader otoano:fx-modulation ;
    rdfs:seeAlso <https://guitar-hakase.com/7628/> .

otoano:fx-vibrato a otoano:GearCategory ;
    schema:name "ビブラート"@ja ;
    schema:description "音程を周期的に揺らすエフェクター。音量を揺らすトレモロとは、揺らす対象が異なる点で区別される。"@ja ;
    skos:broader otoano:fx-modulation ;
    rdfs:seeAlso <https://ja.wikipedia.org/wiki/%E3%83%93%E3%83%96%E3%83%A9%E3%83%BC%E3%83%88> .

otoano:fx-ambient a otoano:GearCategory ;
    schema:name "空間系"@ja ;
    schema:description "残響や音の反復を加え、演奏に奥行きと空間の広さを与える系統。"@ja ;
    skos:broader otoano:effector ;
    rdfs:seeAlso <https://guitar-hakase.com/effector/> .

otoano:fx-reverb a otoano:GearCategory ;
    schema:name "リバーブ"@ja ;
    schema:description "ホールや部屋の残響を再現し、音に奥行きと余韻を与えるエフェクター。かけ過ぎると音の輪郭がぼやけるため、曲の密度に合わせた調整が必要。"@ja ;
    skos:broader otoano:fx-ambient ;
    rdfs:seeAlso <https://guitar-hakase.com/38810/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%AA%E3%83%90%E3%83%BC%E3%83%96> .

otoano:fx-delay a otoano:GearCategory ;
    schema:name "ディレイ"@ja ;
    schema:description "音を遅らせて繰り返す、やまびこのような効果を作るエフェクター。繰り返しの間隔を曲のテンポに合わせるとフレーズに立体感が出る。"@ja ;
    skos:broader otoano:fx-ambient ;
    rdfs:seeAlso <https://guitar-hakase.com/38783/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%87%E3%82%A3%E3%83%AC%E3%82%A4_(%E9%9F%B3%E9%9F%BF%E6%A9%9F%E5%99%A8)> .

otoano:fx-looper a otoano:GearCategory ;
    schema:name "ルーパー"@ja ;
    schema:description "その場で演奏を録音し、繰り返し再生するエフェクター。一人でバッキングを重ねながらソロを弾けるため、練習にも演出にも使われる。"@ja ;
    skos:broader otoano:fx-ambient ;
    rdfs:seeAlso <https://guitar-hakase.com/19104/> .

otoano:fx-filter a otoano:GearCategory ;
    schema:name "フィルター系"@ja ;
    schema:description "特定の周波数帯域を強めたり弱めたりして、音色そのものを作り変える系統。"@ja ;
    skos:broader otoano:effector ;
    rdfs:seeAlso <https://guitar-hakase.com/effector/> .

otoano:fx-eq a otoano:GearCategory ;
    schema:name "イコライザー"@ja ;
    schema:description "低音・中音・高音などの帯域ごとに音量を増減し、音色を細かく整えるエフェクター。バンドの中で埋もれる帯域を持ち上げるなど、音作りの微調整に使う。"@ja ;
    skos:broader otoano:fx-filter ;
    rdfs:seeAlso <https://guitar-hakase.com/7803/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%A4%E3%82%B3%E3%83%A9%E3%82%A4%E3%82%B6%E3%83%BC_(%E9%9F%B3%E9%9F%BF%E6%A9%9F%E5%99%A8)> .

otoano:fx-wah a otoano:GearCategory ;
    schema:name "ワウ"@ja ;
    schema:description "ペダルの踏み込みに応じて強調される周波数が移動し、「ワウワウ」と喋るような音になるエフェクター。カッティングやソロで多用される。"@ja ;
    skos:broader otoano:fx-filter ;
    rdfs:seeAlso <https://guitar-hakase.com/2294/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%AF%E3%82%A6%E3%83%9A%E3%83%80%E3%83%AB> .

otoano:fx-noise-gate a otoano:GearCategory ;
    schema:name "ノイズゲート"@ja ;
    schema:description "設定した音量以下の信号を遮断し、強く歪ませた時に出るノイズを抑えるエフェクター。演奏していない間を静かに保てる。"@ja ;
    skos:broader otoano:fx-filter ;
    rdfs:seeAlso <https://guitar-hakase.com/18988/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%8E%E3%82%A4%E3%82%BA%E3%82%B2%E3%83%BC%E3%83%88> .

otoano:fx-pitch a otoano:GearCategory ;
    schema:name "ピッチ系"@ja ;
    schema:description "元の音に対して音程の違う音を作り出す系統。音に厚みを足したり、演奏では出せない音程変化を作る。"@ja ;
    skos:broader otoano:effector ;
    rdfs:seeAlso <https://guitar-hakase.com/effector/> .

otoano:fx-octaver a otoano:GearCategory ;
    schema:name "オクターバー"@ja ;
    schema:description "元の音の1オクターブ上または下の音を重ねるエフェクター。単音を太く厚くでき、ベースのような低音を足す使い方が代表的。"@ja ;
    skos:broader otoano:fx-pitch ;
    rdfs:seeAlso <https://guitar-hakase.com/20389/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%AF%E3%82%BF%E3%83%BC%E3%83%90%E3%83%BC> .

otoano:fx-pitch-shifter a otoano:GearCategory ;
    schema:name "ピッチシフター"@ja ;
    schema:description "入力された音の音程をずらした音を作り出すエフェクター。ハモリを自動で付けたり、大胆な音程変化の効果音として使う。"@ja ;
    skos:broader otoano:fx-pitch ;
    rdfs:seeAlso <https://guitar-hakase.com/7685/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%BF%E3%82%A4%E3%83%A0%E3%82%B9%E3%83%88%E3%83%AC%E3%83%83%E3%83%81/%E3%83%94%E3%83%83%E3%83%81%E3%82%B7%E3%83%95%E3%83%88> .

otoano:fx-whammy a otoano:GearCategory ;
    schema:name "ワーミー"@ja ;
    schema:description "ペダル操作で音程を大きく上下させるピッチシフターの一種。DigiTech社の製品名が、この種類の呼び名として定着したもの。"@ja ;
    skos:broader otoano:fx-pitch ;
    rdfs:seeAlso <https://guitar-hakase.com/7719/> .

otoano:fx-utility a otoano:GearCategory ;
    schema:name "ダイナミクス・その他"@ja ;
    schema:description "音量や信号の状態を整える、縁の下の役割をもつ系統。派手な変化はないが、演奏のしやすさや音の安定に効く。"@ja ;
    skos:broader otoano:effector ;
    rdfs:seeAlso <https://guitar-hakase.com/effector/> .

otoano:fx-compressor a otoano:GearCategory ;
    schema:name "コンプレッサー"@ja ;
    schema:description "大きい音を抑え小さい音を持ち上げて、音量差を均一にするエフェクター。粒のそろったカッティングや、伸びのあるクリーントーンを作れる。"@ja ;
    skos:broader otoano:fx-utility ;
    rdfs:seeAlso <https://guitar-hakase.com/37538/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%B3%E3%83%B3%E3%83%97%E3%83%AC%E3%83%83%E3%82%B5%E3%83%BC_(%E9%9F%B3%E9%9F%BF%E6%A9%9F%E5%99%A8)> .

otoano:fx-volume-pedal a otoano:GearCategory ;
    schema:name "ボリュームペダル"@ja ;
    schema:description "足元で音量を連続的に変えるエフェクター。曲中の音量調整のほか、ボリューム奏法によるフェードインにも使われる。"@ja ;
    skos:broader otoano:fx-utility ;
    rdfs:seeAlso <https://guitar-hakase.com/18997/> .

otoano:fx-tuner a otoano:GearCategory ;
    schema:name "ペダルチューナー"@ja ;
    schema:description "足元でチューニングを確認できる機器。踏むと音が出なくなる機能をもつものが多く、ライブ中の曲間で音を出さずに調弦できる。"@ja ;
    skos:broader otoano:fx-utility ;
    rdfs:seeAlso <https://guitar-hakase.com/2342/> .

otoano:fx-buffer a otoano:GearCategory ;
    schema:name "バッファー"@ja ;
    schema:description "信号のインピーダンスを変換する機器。シールドが長い場合やエフェクターを多数つないだ場合に起きる高音の減衰を防ぐ。"@ja ;
    skos:broader otoano:fx-utility ;
    rdfs:seeAlso <https://guitar-hakase.com/34497/> .

otoano:gt-strat a otoano:GearCategory ;
    schema:name "ストラトキャスター・タイプ"@ja ;
    schema:description "フェンダー社の代表機種に由来する形状。シングルコイル3基とアーム、深いカッタウェイを備え、軽快で歯切れのよい音が特徴。ジャンルを選ばない万能型として最も普及している。"@ja ;
    skos:broader otoano:guitar ;
    rdfs:seeAlso <https://guitar-hakase.com/24986/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%95%E3%82%A7%E3%83%B3%E3%83%80%E3%83%BC%E3%83%BB%E3%82%B9%E3%83%88%E3%83%A9%E3%83%88%E3%82%AD%E3%83%A3%E3%82%B9%E3%82%BF%E3%83%BC> .

otoano:gt-tele a otoano:GearCategory ;
    schema:name "テレキャスター・タイプ"@ja ;
    schema:description "量産型エレキギターの原型となった形状。シンプルな構造とシングルコイル2基により、輪郭のはっきりした硬めの音になる。カッティングやカントリーで愛用される。"@ja ;
    skos:broader otoano:guitar ;
    rdfs:seeAlso <https://guitar-hakase.com/31129/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%95%E3%82%A7%E3%83%B3%E3%83%80%E3%83%BC%E3%83%BB%E3%83%86%E3%83%AC%E3%82%AD%E3%83%A3%E3%82%B9%E3%82%BF%E3%83%BC> .

otoano:gt-lespaul a otoano:GearCategory ;
    schema:name "レスポール・タイプ"@ja ;
    schema:description "ギブソン社の代表機種に由来する形状。厚いボディとハムバッカー2基により、太く甘く伸びのある音が特徴。ロックの王道とされる。"@ja ;
    skos:broader otoano:guitar ;
    rdfs:seeAlso <https://guitar-hakase.com/33277/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%AE%E3%83%96%E3%82%BD%E3%83%B3%E3%83%BB%E3%83%AC%E3%82%B9%E3%83%9D%E3%83%BC%E3%83%AB> .

otoano:gt-sg a otoano:GearCategory ;
    schema:name "SGタイプ"@ja ;
    schema:description "レスポールより薄く軽いボディに、両側の深いカッタウェイをもつ形状。ハムバッカーながら中音域が張り出した硬めの音で、高音域も弾きやすい。"@ja ;
    skos:broader otoano:guitar ;
    rdfs:seeAlso <https://guitar-hakase.com/4004/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%AE%E3%83%96%E3%82%BD%E3%83%B3%E3%83%BBSG> .

otoano:gt-offset a otoano:GearCategory ;
    schema:name "ジャズマスター／ジャガー・タイプ"@ja ;
    schema:description "ボディの上下が非対称にずれた「オフセット」形状。独特のピックアップと回路をもち、オルタナティブロックの流れの中で再評価された。"@ja ;
    skos:broader otoano:guitar ;
    rdfs:seeAlso <https://guitar-hakase.com/4004/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%95%E3%82%A7%E3%83%B3%E3%83%80%E3%83%BC%E3%83%BB%E3%82%B8%E3%83%A3%E3%82%BA%E3%83%9E%E3%82%B9%E3%82%BF%E3%83%BC> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%95%E3%82%A7%E3%83%B3%E3%83%80%E3%83%BC%E3%83%BB%E3%82%B8%E3%83%A3%E3%82%AC%E3%83%BC> .

otoano:gt-superstrat a otoano:GearCategory ;
    schema:name "スーパーストラト（ディンキー）タイプ"@ja ;
    schema:description "ストラトの形状をベースに、ハムバッカーや弦を固定するアーム、より深いカッタウェイを備え、ハードロック／メタルの速弾きに対応させたタイプ。"@ja ;
    skos:broader otoano:guitar ;
    rdfs:seeAlso <https://guitar-hakase.com/4004/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%B9%E3%83%BC%E3%83%91%E3%83%BC%E3%82%B9%E3%83%88%E3%83%A9%E3%83%88> .

otoano:gt-prs a otoano:GearCategory ;
    schema:name "PRSタイプ"@ja ;
    schema:description "ポール・リード・スミス社に由来する形状。フェンダー系の軽快さとギブソン系の太さの中間を狙った設計で、汎用性が高い。"@ja ;
    skos:broader otoano:guitar ;
    rdfs:seeAlso <https://guitar-hakase.com/4004/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%9D%E3%83%BC%E3%83%AB%E3%83%BB%E3%83%AA%E3%83%BC%E3%83%89%E3%83%BB%E3%82%B9%E3%83%9F%E3%82%B9> .

otoano:gt-v-shape a otoano:GearCategory ;
    schema:name "変形（フライングV／エクスプローラー）タイプ"@ja ;
    schema:description "V字や鋭角など、通常のギターと大きく異なる輪郭をもつタイプ。見た目のインパクトが強く、ハードロックやメタルで好まれる。"@ja ;
    skos:broader otoano:guitar ;
    rdfs:seeAlso <https://guitar-hakase.com/4004/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%AE%E3%83%96%E3%82%BD%E3%83%B3%E3%83%BB%E3%83%95%E3%83%A9%E3%82%A4%E3%83%B3%E3%82%B0V> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%AE%E3%83%96%E3%82%BD%E3%83%B3%E3%83%BB%E3%82%A8%E3%82%AF%E3%82%B9%E3%83%97%E3%83%AD%E3%83%BC%E3%83%A9%E3%83%BC> .

otoano:gt-semi-hollow a otoano:GearCategory ;
    schema:name "セミアコースティック"@ja ;
    schema:description "ボディ内部に空洞をもちながら、中央に芯材を通した構造。豊かな鳴りとハウリングへの強さを両立しており、ジャズやブルースで使われる。"@ja ;
    skos:broader otoano:guitar ;
    rdfs:seeAlso <https://ja.wikipedia.org/wiki/%E3%82%A8%E3%83%AC%E3%82%AF%E3%83%88%E3%83%AA%E3%83%83%E3%82%AF%E3%83%BB%E3%82%AE%E3%82%BF%E3%83%BC> .

otoano:gt-hollow a otoano:GearCategory ;
    schema:name "フルアコースティック"@ja ;
    schema:description "ボディ全体が空洞になった構造。柔らかく豊かな鳴りが特徴でジャズの定番だが、音量を上げるとハウリングを起こしやすい。"@ja ;
    skos:broader otoano:guitar ;
    rdfs:seeAlso <https://ja.wikipedia.org/wiki/%E3%82%A8%E3%83%AC%E3%82%AF%E3%83%88%E3%83%AA%E3%83%83%E3%82%AF%E3%83%BB%E3%82%AE%E3%82%BF%E3%83%BC> .

otoano:gt-multi-string a otoano:GearCategory ;
    schema:name "多弦（7弦以上）ギター"@ja ;
    schema:description "通常の6弦に低音弦を追加したタイプ。より低い音域が出せるため、重く低い音を求めるメタル系のジャンルで使われる。"@ja ;
    skos:broader otoano:guitar ;
    rdfs:seeAlso <https://guitar-hakase.com/4004/> ,
                 <https://ja.wikipedia.org/wiki/7%E5%BC%A6%E3%82%AE%E3%82%BF%E3%83%BC> .

otoano:amp-form a otoano:GearCategory ;
    schema:name "筐体の形式"@ja ;
    schema:description "アンプをどのような箱の構成で使うかによる分類。持ち運びやすさと出せる音量が変わる。"@ja ;
    skos:broader otoano:amp ;
    rdfs:seeAlso <https://guitar-hakase.com/amp/> .

otoano:amp-combo a otoano:GearCategory ;
    schema:name "コンボアンプ"@ja ;
    schema:description "プリアンプ・パワーアンプ・スピーカーを1台にまとめたタイプ。これだけで音が出せるため、練習からライブまで最も広く使われる。"@ja ;
    skos:broader otoano:amp-form ;
    rdfs:seeAlso <https://guitar-hakase.com/amp/> .

otoano:amp-stack a otoano:GearCategory ;
    schema:name "スタックアンプ"@ja ;
    schema:description "アンプヘッドとキャビネットを積み重ねて使う構成。大音量と迫力が出せるため、大きな会場やハードロックで使われる。"@ja ;
    skos:broader otoano:amp-form ;
    rdfs:seeAlso <https://guitar-hakase.com/amp/> .

otoano:amp-head a otoano:GearCategory ;
    schema:name "アンプヘッド"@ja ;
    schema:description "増幅する部分だけを独立させた機器。スピーカーをもたないため、別途キャビネットにつないで鳴らす。"@ja ;
    skos:broader otoano:amp-form ;
    rdfs:seeAlso <https://guitar-hakase.com/40621/> .

otoano:amp-cabinet a otoano:GearCategory ;
    schema:name "キャビネット"@ja ;
    schema:description "スピーカーを収めた箱。スピーカーの口径や本数、箱の構造によって音の響き方が変わる。"@ja ;
    skos:broader otoano:amp-form ;
    rdfs:seeAlso <https://guitar-hakase.com/8190/> .

otoano:amp-desktop a otoano:GearCategory ;
    schema:name "デスクトップ・小型アンプ"@ja ;
    schema:description "机の上に置ける小型のアンプ。自宅練習向けで、ヘッドホン出力や録音用の端子をもつものが多い。"@ja ;
    skos:broader otoano:amp-form ;
    rdfs:seeAlso <https://guitar-hakase.com/amp/> .

otoano:amp-circuit a otoano:GearCategory ;
    schema:name "増幅方式"@ja ;
    schema:description "信号をどのような回路で増幅するかによる分類。歪み方と音の質感を最も大きく左右する。"@ja ;
    skos:broader otoano:amp ;
    rdfs:seeAlso <https://guitar-hakase.com/amp/> .

otoano:amp-tube a otoano:GearCategory ;
    schema:name "真空管アンプ"@ja ;
    schema:description "真空管で信号を増幅する方式。音量を上げるにつれて自然に歪み、温かみと粘りのある音になる。チューブアンプとも呼ばれる。"@ja ;
    skos:broader otoano:amp-circuit ;
    rdfs:seeAlso <https://guitar-hakase.com/8044/> ,
                 <https://ja.wikipedia.org/wiki/%E7%9C%9F%E7%A9%BA%E7%AE%A1> .

otoano:amp-transistor a otoano:GearCategory ;
    schema:name "トランジスタアンプ"@ja ;
    schema:description "半導体で増幅する方式。クリアでタイトな音になり、扱いやすく壊れにくい。ソリッドステートとも呼ばれる。"@ja ;
    skos:broader otoano:amp-circuit ;
    rdfs:seeAlso <https://guitar-hakase.com/amp/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%88%E3%83%A9%E3%83%B3%E3%82%B8%E3%82%B9%E3%82%BF> .

otoano:amp-modeling a otoano:GearCategory ;
    schema:name "モデリングアンプ"@ja ;
    schema:description "さまざまなアンプの音をデジタル処理で再現するタイプ。1台で多くの音色を切り替えられ、設定を保存できるものが多い。"@ja ;
    skos:broader otoano:amp-circuit ;
    rdfs:seeAlso <https://guitar-hakase.com/amp/> .

otoano:strings-material a otoano:GearCategory ;
    schema:name "素材"@ja ;
    schema:description "弦に何を使っているかによる分類。音の明るさ、指ざわり、錆びにくさが変わる。"@ja ;
    skos:broader otoano:strings ;
    rdfs:seeAlso <https://guitar-hakase.com/strings/> .

otoano:strings-nickel a otoano:GearCategory ;
    schema:name "ニッケル弦"@ja ;
    schema:description "最も普及している標準的な素材。音のバランスがよく指へのあたりも柔らかいため、迷ったらこれを選べばよいとされる。"@ja ;
    skos:broader otoano:strings-material ;
    rdfs:seeAlso <https://guitar-hakase.com/strings/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%8B%E3%83%83%E3%82%B1%E3%83%AB> .

otoano:strings-stainless a otoano:GearCategory ;
    schema:name "ステンレス弦"@ja ;
    schema:description "シャープで乾いた音になり、錆びにくいのが特徴。ニッケルより硬いため、指やフレットへのあたりは強くなる。"@ja ;
    skos:broader otoano:strings-material ;
    rdfs:seeAlso <https://guitar-hakase.com/strings/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%B9%E3%83%86%E3%83%B3%E3%83%AC%E3%82%B9%E9%8B%BC> .

otoano:strings-coated a otoano:GearCategory ;
    schema:name "コーティング弦"@ja ;
    schema:description "表面を薄い膜で覆い、汗や汚れによる劣化を防いだ弦。寿命が長い一方で価格は高めになる。"@ja ;
    skos:broader otoano:strings-material ;
    rdfs:seeAlso <https://guitar-hakase.com/strings/> .

otoano:strings-gauge a otoano:GearCategory ;
    schema:name "ゲージ（太さ）"@ja ;
    schema:description "弦の太さによる分類。細いほど押さえやすくチョーキングが軽く、太いほど音が太く張りが出る。"@ja ;
    skos:broader otoano:strings ;
    rdfs:seeAlso <https://guitar-hakase.com/strings/> .

otoano:strings-extra-light a otoano:GearCategory ;
    schema:name "エクストラライト"@ja ;
    schema:description "1弦が.008インチ前後の最も細いゲージ。押さえるのもチョーキングも軽いが、音は細くなりやすい。"@ja ;
    skos:broader otoano:strings-gauge ;
    rdfs:seeAlso <https://guitar-hakase.com/strings/> .

otoano:strings-super-light a otoano:GearCategory ;
    schema:name "スーパーライト"@ja ;
    schema:description "1弦が.009インチ前後。細さと音のバランスがよく、扱いやすい太さとして広く使われる。"@ja ;
    skos:broader otoano:strings-gauge ;
    rdfs:seeAlso <https://guitar-hakase.com/strings/> .

otoano:strings-light a otoano:GearCategory ;
    schema:name "ライト"@ja ;
    schema:description "1弦が.010インチ前後。音の太さと弾きやすさのバランスが取れた標準的なゲージ。"@ja ;
    skos:broader otoano:strings-gauge ;
    rdfs:seeAlso <https://guitar-hakase.com/strings/> .

otoano:strings-medium a otoano:GearCategory ;
    schema:name "ミディアム"@ja ;
    schema:description "1弦が.011インチ前後。音は太く張りが出るが、押さえる力とチョーキングの負荷は増す。"@ja ;
    skos:broader otoano:strings-gauge ;
    rdfs:seeAlso <https://guitar-hakase.com/strings/> .

otoano:strings-heavy a otoano:GearCategory ;
    schema:name "ヘビー"@ja ;
    schema:description "1弦が.012インチ以上の太いゲージ。低く下げたチューニングや、より太い音を求める場合に使われる。"@ja ;
    skos:broader otoano:strings-gauge ;
    rdfs:seeAlso <https://guitar-hakase.com/strings/> .

otoano:pick-shape a otoano:GearCategory ;
    schema:name "形状"@ja ;
    schema:description "ピックの輪郭による分類。持ちやすさと、弦にあたる先端の鋭さが変わる。"@ja ;
    skos:broader otoano:pick ;
    rdfs:seeAlso <https://guitar-hakase.com/pick/> .

otoano:pick-teardrop a otoano:GearCategory ;
    schema:name "ティアドロップ"@ja ;
    schema:description "涙のしずくのような形。先端が細く、単音弾きにもコード弾きにも対応できる最も標準的な形状。"@ja ;
    skos:broader otoano:pick-shape ;
    rdfs:seeAlso <https://guitar-hakase.com/pick/> .

otoano:pick-triangle a otoano:GearCategory ;
    schema:name "トライアングル（おにぎり型）"@ja ;
    schema:description "三角形で、3つの角すべてを使える形。面積が広く持ちやすいため、ストロークに向く。"@ja ;
    skos:broader otoano:pick-shape ;
    rdfs:seeAlso <https://guitar-hakase.com/pick/> .

otoano:pick-jazz a otoano:GearCategory ;
    schema:name "ジャズ型"@ja ;
    schema:description "小ぶりで先端が鋭い形。ピックの動きが正確になり、速いフレーズや単音弾きに向く。"@ja ;
    skos:broader otoano:pick-shape ;
    rdfs:seeAlso <https://guitar-hakase.com/pick/> .

otoano:pick-thumb a otoano:GearCategory ;
    schema:name "サムピック"@ja ;
    schema:description "親指にはめて使うピック。指弾きと組み合わせられるため、ベース音と伴奏を同時に鳴らす演奏に使われる。"@ja ;
    skos:broader otoano:pick-shape ;
    rdfs:seeAlso <https://guitar-hakase.com/pick/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%B5%E3%83%A0%E3%83%94%E3%83%83%E3%82%AF> .

otoano:pick-thickness a otoano:GearCategory ;
    schema:name "厚さ"@ja ;
    schema:description "ピックの厚みによる分類。薄いほどしなってストロークが軽やかになり、厚いほど力がそのまま弦に伝わる。"@ja ;
    skos:broader otoano:pick ;
    rdfs:seeAlso <https://guitar-hakase.com/pick/> .

otoano:pick-thin a otoano:GearCategory ;
    schema:name "シン（薄い）"@ja ;
    schema:description "0.5mm前後の薄いピック。よくしなるためストロークが軽やかになるが、単音の芯は出にくい。"@ja ;
    skos:broader otoano:pick-thickness ;
    rdfs:seeAlso <https://guitar-hakase.com/pick/> .

otoano:pick-medium a otoano:GearCategory ;
    schema:name "ミディアム"@ja ;
    schema:description "0.7mm前後の標準的な厚さ。ストロークと単音弾きの両方に対応できる。"@ja ;
    skos:broader otoano:pick-thickness ;
    rdfs:seeAlso <https://guitar-hakase.com/pick/> .

otoano:pick-heavy a otoano:GearCategory ;
    schema:name "ヘビー（厚い）"@ja ;
    schema:description "0.9mm以上の厚いピック。しなりが少なく力がそのまま弦に伝わるため、単音弾きや速弾きに向く。"@ja ;
    skos:broader otoano:pick-thickness ;
    rdfs:seeAlso <https://guitar-hakase.com/pick/> .

otoano:pick-material a otoano:GearCategory ;
    schema:name "素材"@ja ;
    schema:description "ピックに使われている樹脂などによる分類。しなり方、削れにくさ、弦にあたる音の質感が変わる。"@ja ;
    skos:broader otoano:pick ;
    rdfs:seeAlso <https://guitar-hakase.com/pick/> .

otoano:pick-celluloid a otoano:GearCategory ;
    schema:name "セルロイド"@ja ;
    schema:description "古くから使われている定番の素材。適度なしなりと滑らかな弾き心地が特徴。"@ja ;
    skos:broader otoano:pick-material ;
    rdfs:seeAlso <https://guitar-hakase.com/pick/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%BB%E3%83%AB%E3%83%AD%E3%82%A4%E3%83%89> .

otoano:pick-nylon a otoano:GearCategory ;
    schema:name "ナイロン"@ja ;
    schema:description "しなやかで手になじむ素材。表面に滑り止めの加工がされたものが多い。"@ja ;
    skos:broader otoano:pick-material ;
    rdfs:seeAlso <https://guitar-hakase.com/pick/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%8A%E3%82%A4%E3%83%AD%E3%83%B3> .

otoano:pick-delrin a otoano:GearCategory ;
    schema:name "デルリン"@ja ;
    schema:description "摩耗に強く、表面がさらっとした素材。硬さが安定しており削れにくい。"@ja ;
    skos:broader otoano:pick-material ;
    rdfs:seeAlso <https://guitar-hakase.com/pick/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%87%E3%83%AB%E3%83%AA%E3%83%B3> .

otoano:pick-ultem a otoano:GearCategory ;
    schema:name "ウルテム"@ja ;
    schema:description "硬く、はっきりしたアタック音が出る素材。べっ甲に近い硬質な弾き心地とされる。"@ja ;
    skos:broader otoano:pick-material ;
    rdfs:seeAlso <https://guitar-hakase.com/pick/> .

#################################################################
# 奏法の統制語彙（エレキギター向け・27項目）
# 全項目に外部解説（guitar-hakase / Wikipedia日本語版）を rdfs:seeAlso で接続する。
# 対応があるものは GRO（Guitar Rendition Ontology）のクラス名を otoano:groClass で示す。
# skos:broader で下記の4グループに束ね、UIの並び順と一致させる。
#################################################################

otoano:tg-basic a otoano:Technique ; schema:name "基本・コード"@ja .
otoano:tg-picking a otoano:Technique ; schema:name "ピッキング"@ja .
otoano:tg-fingering a otoano:Technique ; schema:name "フィンガリング"@ja .
otoano:tg-electric a otoano:Technique ; schema:name "エレキ特有"@ja .
otoano:tg-other a otoano:Technique ; schema:name "その他"@ja .

otoano:stroke a otoano:Technique ;
    schema:name "ストローク"@ja ;
    schema:description "複数の弦をまとめて弾く動作。ダウンストロークとアップストロークを組み合わせてリズムを刻む。初心者が最初に覚える基本動作であり、リズムの安定が上達の鍵になる。"@ja ;
    skos:broader otoano:tg-basic ;
    rdfs:seeAlso <https://guitar-hakase.com/2774/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%94%E3%83%83%E3%82%AF%E5%A5%8F%E6%B3%95> .

otoano:cutting a otoano:Technique ;
    schema:name "カッティング"@ja ;
    schema:description "弦を弾いた直後に手を弦へ触れさせ、音を短く切る奏法。ファンクやポップスでリズムを強調する際によく使われる。音の粒がはっきりするため、グルーヴ感の演出に効果的。"@ja ;
    skos:broader otoano:tg-basic ;
    rdfs:seeAlso <https://guitar-hakase.com/2735/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%9F%E3%83%A5%E3%83%BC%E3%83%88_(%E3%82%AE%E3%82%BF%E3%83%BC)> .

otoano:brushing a otoano:Technique ;
    schema:name "ブラッシング"@ja ;
    schema:description "左手で弦を押さえずに軽く触れたまま弾き、音程のない「ジャッ」という打楽器的な音を出す奏法。カッティングの合間に混ぜることでリズムのノリを作る。"@ja ;
    skos:broader otoano:tg-basic ;
    rdfs:seeAlso <https://guitar-hakase.com/2768/> .

otoano:bridge-mute a otoano:Technique ;
    schema:name "ブリッジミュート"@ja ;
    schema:description "右手の側面をブリッジ付近の弦に軽く押し当てて、重厚でタイトな音を出す奏法。ロックやパンクのバッキングで必須となる。押し当てる強さで音のこもり具合を調整できる。"@ja ;
    skos:broader otoano:tg-basic ;
    rdfs:seeAlso <https://guitar-hakase.com/2766/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%9F%E3%83%A5%E3%83%BC%E3%83%88_(%E3%82%AE%E3%82%BF%E3%83%BC)> .

otoano:chord-change a otoano:Technique ;
    schema:name "コードチェンジ"@ja ;
    schema:description "押さえるコードを切り替える動作。次のコードと共通する指を離さずに残すと指の移動が減り、音を途切れさせずにつなげられる。初心者が最初につまずきやすい部分。"@ja ;
    skos:broader otoano:tg-basic ;
    rdfs:seeAlso <https://guitar-hakase.com/2403/> .

otoano:barre-chord a otoano:Technique ;
    schema:name "バレーコード"@ja ;
    schema:description "人差し指で複数の弦をまとめて押さえるフォーム。同じ形を平行移動するだけで多くのコードが弾けるため、覚える押さえ方の数を大幅に減らせる。セーハとも呼ばれる。"@ja ;
    skos:broader otoano:tg-basic ;
    otoano:groClass "Ceja" ;
    rdfs:seeAlso <https://guitar-hakase.com/5639/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%90%E3%83%AC%E3%83%BC%E3%82%B3%E3%83%BC%E3%83%89> .

otoano:power-chord a otoano:Technique ;
    schema:name "パワーコード"@ja ;
    schema:description "ルートと5度（および1オクターブ上のルート）だけを鳴らす和音。長三度・短三度を含まないため明暗が決まらず、強く歪ませても音が濁りにくい。ロックの中核となる響き。"@ja ;
    skos:broader otoano:tg-basic ;
    rdfs:seeAlso <https://guitar-hakase.com/2770/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%91%E3%83%AF%E3%83%BC%E3%82%B3%E3%83%BC%E3%83%89> .

otoano:arpeggio a otoano:Technique ;
    schema:name "アルペジオ"@ja ;
    schema:description "和音を同時に鳴らさず、構成音を1音ずつ順に鳴らしていく奏法。コード感を保ったまま静かな響きを作れるため、バラードやイントロで多用される。分散和音とも呼ばれる。"@ja ;
    skos:broader otoano:tg-basic ;
    otoano:groClass "Arpeggio" ;
    rdfs:seeAlso <https://ja.wikipedia.org/wiki/%E3%82%A2%E3%83%AB%E3%83%9A%E3%83%83%E3%82%B8%E3%83%A7> .

otoano:octave a otoano:Technique ;
    schema:name "オクターブ奏法"@ja ;
    schema:description "同じ音を1オクターブ違いで同時に鳴らす奏法。間に挟まる弦はミュートして2音だけを響かせる。単音より太く、バンドの中でも埋もれにくいメロディになる。"@ja ;
    skos:broader otoano:tg-basic ;
    otoano:groClass "Octave" ;
    rdfs:seeAlso <https://guitar-hakase.com/3709/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%AF%E3%82%BF%E3%83%BC%E3%83%B4%E5%A5%8F%E6%B3%95> .

otoano:alternate-picking a otoano:Technique ;
    schema:name "オルタネイトピッキング"@ja ;
    schema:description "ダウンとアップを規則的に交互に繰り返すピッキング。ピックの無駄な動きが減るため、速いフレーズを安定して弾ける。速弾きの土台となる基礎技術。"@ja ;
    skos:broader otoano:tg-picking ;
    rdfs:seeAlso <https://guitar-hakase.com/2764/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%94%E3%83%83%E3%82%AF%E5%A5%8F%E6%B3%95> .

otoano:tremolo-picking a otoano:Technique ;
    schema:name "トレモロピッキング"@ja ;
    schema:description "同じ音を極めて速く連続して刻む奏法。音が途切れず持続しているように聞こえ、緊張感や盛り上がりを作り出せる。"@ja ;
    skos:broader otoano:tg-picking ;
    otoano:groClass "Tremolo" ;
    rdfs:seeAlso <https://ja.wikipedia.org/wiki/%E3%83%88%E3%83%AC%E3%83%A2%E3%83%AD> .

otoano:sweep-picking a otoano:Technique ;
    schema:name "スウィープピッキング"@ja ;
    schema:description "隣り合う弦を、箒で掃くようにダウン（またはアップ）方向へ連続して弾く奏法。アルペジオを高速で流れるように鳴らせる。"@ja ;
    skos:broader otoano:tg-picking ;
    rdfs:seeAlso <https://guitar-hakase.com/2776/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%B9%E3%82%A6%E3%82%A3%E3%83%BC%E3%83%97%E5%A5%8F%E6%B3%95> .

otoano:picking-harmonics a otoano:Technique ;
    schema:name "ピッキングハーモニクス"@ja ;
    schema:description "ピッキングと同時に親指を弦へ軽く触れさせ、倍音を強調した甲高い音を出す奏法。歪ませたリードギターで、叫ぶような効果を作るときに使われる。"@ja ;
    skos:broader otoano:tg-picking ;
    rdfs:seeAlso <https://guitar-hakase.com/2760/> .

otoano:hammer-on a otoano:Technique ;
    schema:name "ハンマリング・オン"@ja ;
    schema:description "押さえている指より高いフレットを別の指で叩きつけて発音する奏法。ピッキングせずに音をつなぐため、なめらかな上行フレーズになる。"@ja ;
    skos:broader otoano:tg-fingering ;
    otoano:groClass "Ascending_slur" ;
    rdfs:seeAlso <https://guitar-hakase.com/10535/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%8F%E3%83%B3%E3%83%9E%E3%83%AA%E3%83%B3%E3%82%B0%E3%83%BB%E3%82%AA%E3%83%B3> .

otoano:pull-off a otoano:Technique ;
    schema:name "プリング・オフ"@ja ;
    schema:description "押さえていた指を弦に引っかけながら離して発音する奏法。ハンマリングと逆方向の動きで、下行フレーズをなめらかにつなぐ。"@ja ;
    skos:broader otoano:tg-fingering ;
    otoano:groClass "Descending_slur" ;
    rdfs:seeAlso <https://guitar-hakase.com/10535/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%97%E3%83%AA%E3%83%B3%E3%82%B0%E3%83%BB%E3%82%AA%E3%83%95> .

otoano:trill a otoano:Technique ;
    schema:name "トリル"@ja ;
    schema:description "ハンマリングとプリングを高速で繰り返し、隣り合う2つの音を細かく行き来させる装飾技法。緊張感のある持続音として使われる。"@ja ;
    skos:broader otoano:tg-fingering ;
    rdfs:seeAlso <https://guitar-hakase.com/2754/> ,
                 <https://ja.wikipedia.org/wiki/%E8%A3%85%E9%A3%BE%E9%9F%B3> .

otoano:slide a otoano:Technique ;
    schema:name "スライド"@ja ;
    schema:description "弦を押さえたまま指を滑らせて別のフレットへ移動し、音程を連続的に変化させる奏法。フレーズのつなぎに表情を与える。"@ja ;
    skos:broader otoano:tg-fingering ;
    otoano:groClass "Slide" ;
    rdfs:seeAlso <https://guitar-hakase.com/2752/> .

otoano:glissando a otoano:Technique ;
    schema:name "グリッサンド"@ja ;
    schema:description "到達する音を特定せず、音程を大きく滑らせる奏法。イントロや場面の切り替えで勢いをつける効果として使われる。"@ja ;
    skos:broader otoano:tg-fingering ;
    otoano:groClass "Glissando" ;
    rdfs:seeAlso <https://guitar-hakase.com/2752/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%B0%E3%83%AA%E3%83%83%E3%82%B5%E3%83%B3%E3%83%89> .

otoano:choking a otoano:Technique ;
    schema:name "チョーキング"@ja ;
    schema:description "弦を指で押し上げて音程を変化させる奏法。ギターを歌わせるような表現が可能になり、ソロ演奏で非常に多用される。半音〜全音が一般的で、ビブラートと組み合わせると表現がより豊かになる。"@ja ;
    skos:broader otoano:tg-fingering ;
    otoano:groClass "Choking" ;
    rdfs:seeAlso <https://guitar-hakase.com/2758/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%81%E3%83%A7%E3%83%BC%E3%82%AD%E3%83%B3%E3%82%B0> .

otoano:vibrato a otoano:Technique ;
    schema:name "ビブラート"@ja ;
    schema:description "音を伸ばしている間に音程を細かく揺らし、音に張りと余韻を与える奏法。揺らす速さと幅に奏者の個性が最も表れる部分とされる。"@ja ;
    skos:broader otoano:tg-fingering ;
    otoano:groClass "Vibrato" ;
    rdfs:seeAlso <https://guitar-hakase.com/2756/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%93%E3%83%96%E3%83%A9%E3%83%BC%E3%83%88> .

otoano:tapping a otoano:Technique ;
    schema:name "タッピング"@ja ;
    schema:description "右手の指で指板を叩いて発音する奏法。左手だけでは届かない広い音程差のフレーズを弾ける。ライトハンド奏法とも呼ばれる。"@ja ;
    skos:broader otoano:tg-fingering ;
    otoano:groClass "Tapping" ;
    rdfs:seeAlso <https://guitar-hakase.com/1235/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%BF%E3%83%83%E3%83%94%E3%83%B3%E3%82%B0%E5%A5%8F%E6%B3%95> .

otoano:harmonics a otoano:Technique ;
    schema:name "ハーモニクス"@ja ;
    schema:description "弦の特定の位置に指を軽く触れさせたまま弾き、倍音だけを響かせる奏法。澄んだ鐘のような音になる。12・7・5フレット上が代表的な位置。"@ja ;
    skos:broader otoano:tg-fingering ;
    otoano:groClass "Natural_harmonics" ;
    rdfs:seeAlso <https://guitar-hakase.com/2762/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%95%E3%83%A9%E3%82%B8%E3%82%AA%E3%83%AC%E3%83%83%E3%83%88> .

otoano:arming a otoano:Technique ;
    schema:name "アーミング"@ja ;
    schema:description "ブリッジのアーム（トレモロユニット）を操作して弦の張力を変え、音程を上下させる奏法。細かい揺らしから急激な音程変化まで作れる、エレキギター特有の表現。"@ja ;
    skos:broader otoano:tg-electric ;
    rdfs:seeAlso <https://guitar-hakase.com/26557/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%A2%E3%83%BC%E3%83%9F%E3%83%B3%E3%82%B0> .

otoano:slide-bar a otoano:Technique ;
    schema:name "ボトルネック奏法"@ja ;
    schema:description "ガラスや金属の筒（スライドバー）を指にはめ、弦に当てたまま滑らせて演奏する奏法。フレットに区切られない連続的な音程が得られる。ブルースで多用される。"@ja ;
    skos:broader otoano:tg-electric ;
    rdfs:seeAlso <https://guitar-hakase.com/1257/> ,
                 <https://ja.wikipedia.org/wiki/%E3%82%B9%E3%83%A9%E3%82%A4%E3%83%89%E3%82%AE%E3%82%BF%E3%83%BC> .

otoano:volume-swell a otoano:Technique ;
    schema:name "ボリューム奏法"@ja ;
    schema:description "ボリュームを絞った状態で弦を弾き、直後にボリュームを上げてアタック音を消す奏法。バイオリンのようにふわりと立ち上がる音になる。バイオリン奏法とも呼ばれる。"@ja ;
    skos:broader otoano:tg-electric ;
    rdfs:seeAlso <https://guitar-hakase.com/1253/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%90%E3%82%A4%E3%82%AA%E3%83%AA%E3%83%B3%E5%A5%8F%E6%B3%95> .

otoano:feedback-play a otoano:Technique ;
    schema:name "フィードバック奏法"@ja ;
    schema:description "アンプから出た音をギターのピックアップが拾うことで生じる発振音を、意図的に楽音として使う奏法。音を長く伸ばしたり、叫ぶような効果を作る。"@ja ;
    skos:broader otoano:tg-electric ;
    rdfs:seeAlso <https://guitar-hakase.com/1247/> ,
                 <https://ja.wikipedia.org/wiki/%E3%83%95%E3%82%A3%E3%83%BC%E3%83%89%E3%83%90%E3%83%83%E3%82%AF%E5%A5%8F%E6%B3%95> .

otoano:other-technique a otoano:Technique ;
    schema:name "その他"@ja ;
    schema:description "統制語彙に該当する奏法がない場合に選ぶ項目。具体的な名称は投稿時に自由入力する。"@ja ;
    skos:broader otoano:tg-other .

#################################################################
# ジャンル（schema:genre の値）と難易度（otoano:difficulty の値）
# どちらも独自クラスは作らず、SKOS の ConceptScheme でまとめる。
#################################################################

otoano:GenreScheme a skos:ConceptScheme ;
    schema:name "ジャンル"@ja ;
    rdfs:comment "楽曲アノテーションのジャンル。schema:genre の値として用いる。"@ja .

otoano:DifficultyScheme a skos:ConceptScheme ;
    schema:name "難易度"@ja ;
    rdfs:comment "そのパートをコピーする難しさ。otoano:difficulty の値として用いる。skos:notation の1〜4が易しい順の並び。"@ja .

otoano:genre-rock a skos:Concept ; skos:inScheme otoano:GenreScheme ; schema:name "ロック"@ja .
otoano:genre-jpop a skos:Concept ; skos:inScheme otoano:GenreScheme ; schema:name "J-POP"@ja .
otoano:genre-pop a skos:Concept ; skos:inScheme otoano:GenreScheme ; schema:name "ポップス"@ja .
otoano:genre-punk a skos:Concept ; skos:inScheme otoano:GenreScheme ; schema:name "パンク"@ja .
otoano:genre-metal a skos:Concept ; skos:inScheme otoano:GenreScheme ; schema:name "メタル・ハードロック"@ja .
otoano:genre-alternative a skos:Concept ; skos:inScheme otoano:GenreScheme ; schema:name "オルタナティブ"@ja .
otoano:genre-blues a skos:Concept ; skos:inScheme otoano:GenreScheme ; schema:name "ブルース"@ja .
otoano:genre-funk a skos:Concept ; skos:inScheme otoano:GenreScheme ; schema:name "ファンク"@ja .
otoano:genre-jazz a skos:Concept ; skos:inScheme otoano:GenreScheme ; schema:name "ジャズ"@ja .
otoano:genre-ballad a skos:Concept ; skos:inScheme otoano:GenreScheme ; schema:name "バラード"@ja .
otoano:genre-folk a skos:Concept ; skos:inScheme otoano:GenreScheme ; schema:name "フォーク・弾き語り"@ja .
otoano:genre-anime a skos:Concept ; skos:inScheme otoano:GenreScheme ; schema:name "アニメ・ゲーム"@ja .
otoano:genre-other a skos:Concept ; skos:inScheme otoano:GenreScheme ; schema:name "その他"@ja .

otoano:diff-beginner a skos:Concept ;
    skos:inScheme otoano:DifficultyScheme ;
    skos:notation "1" ;
    schema:name "入門"@ja ;
    schema:description "コードを押さえられれば通して弾ける。特殊な奏法をほとんど含まない。"@ja .

otoano:diff-easy a skos:Concept ;
    skos:inScheme otoano:DifficultyScheme ;
    skos:notation "2" ;
    schema:name "初級"@ja ;
    schema:description "基本的な奏法の組み合わせで弾ける。テンポやコードチェンジに慣れが必要。"@ja .

otoano:diff-intermediate a skos:Concept ;
    skos:inScheme otoano:DifficultyScheme ;
    skos:notation "3" ;
    schema:name "中級"@ja ;
    schema:description "複数の奏法の切り替えや、細かいリズム・音作りの再現が求められる。"@ja .

otoano:diff-advanced a skos:Concept ;
    skos:inScheme otoano:DifficultyScheme ;
    skos:notation "4" ;
    schema:name "上級"@ja ;
    schema:description "速弾きや特殊奏法、機材の切り替えを含み、通して弾くには相応の練習を要する。"@ja .
